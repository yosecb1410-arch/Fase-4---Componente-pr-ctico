    _manejador.setFormatter(logging.Formatter("%(asctime)s | %(levelname)-8s | %(message)s"))
    # Conecta el manejador con el registrador.
    logger.addHandler(_manejador)
 
 
# SECCIÓN 3: CLASE ABSTRACTA BASE Y CLASE CLIENTE
class EntidadBase(ABC):
    """Clase abstracta que representa cualquier entidad general del sistema."""
 
    _contador = 0  # contador compartido por todas las entidades para dar identificadores únicos
 
    def __init__(self):
        """Constructor: asigna un identificador único y creciente."""
        EntidadBase._contador += 1       # incrementa el contador global
        self._id = EntidadBase._contador # guarda el id en un atributo protegido (encapsulado)
 
    @property
    def id(self):
        """Identificador de solo lectura (no tiene setter, así no se puede modificar)."""
        return self._id
 
    @abstractmethod
    def describir(self) -> str:
        """Método abstracto: cada entidad debe describirse a sí misma (polimorfismo)."""
 
    def __str__(self):
        """Al imprimir cualquier entidad se muestra su descripción."""
        return self.describir()
 
 
class Cliente(EntidadBase):
    """Cliente con datos personales encapsulados y validados estrictamente."""
 
    # Patrón de correo: texto@dominio.extensión (compilado una sola vez para eficiencia).
    _PATRON_CORREO = re.compile(r"^[\w.+-]+@[\w-]+\.[\w.-]+$")
 
    def __init__(self, nombre=None, documento=None, correo=None, telefono=None):
        """Crea un cliente; cada asignación pasa por su setter y se valida."""
        super().__init__()          # genera el id llamando al constructor de EntidadBase
        self.nombre = nombre        # ejecuta el setter de nombre
        self.documento = documento  # ejecuta el setter de documento
        self.correo = correo        # ejecuta el setter de correo
        self.telefono = telefono    # ejecuta el setter de teléfono
 
    # nombre
    @property
    def nombre(self):
        """Devuelve el nombre (atributo privado con name mangling)."""
        return self.__nombre
 
    @nombre.setter
    def nombre(self, valor):
        """Valida y guarda el nombre."""
        if valor is None:                                   # falta el parámetro
            raise ParametroFaltanteError("El nombre es obligatorio.")
        # Debe ser texto, tener al menos 3 caracteres útiles y no contener números.
        if not isinstance(valor, str) or len(valor.strip()) < 3 or any(c.isdigit() for c in valor):
            raise ClienteInvalidoError(f"Nombre inválido: {valor!r}")
        self.__nombre = valor.strip().title()               # guarda limpio y con formato de nombre propio
 
    # documento
    @property
    def documento(self):
        """Devuelve el documento."""
        return self.__documento
 
    @documento.setter
    def documento(self, valor):
        """Valida y guarda el documento (solo dígitos, entre 6 y 12)."""
        if valor is None:                                   # falta el parámetro
            raise ParametroFaltanteError("El documento es obligatorio.")
        valor = str(valor).strip()                          # lo convierte a texto sin espacios
        if not valor.isdigit() or not 6 <= len(valor) <= 12:
            raise ClienteInvalidoError(f"Documento inválido (6-12 dígitos): {valor!r}")
        self.__documento = valor                            # guarda el valor válido
 
    # correo
    @property
    def correo(self):
        """Devuelve el correo."""
        return self.__correo
 
    @correo.setter
    def correo(self, valor):
        """Valida y guarda el correo electrónico."""
        if valor is None:                                   # falta el parámetro
            raise ParametroFaltanteError("El correo es obligatorio.")
        if not isinstance(valor, str) or not self._PATRON_CORREO.match(valor):
            raise ClienteInvalidoError(f"Correo inválido: {valor!r}")
        self.__correo = valor.lower()                       # se guarda en minúsculas
 
    # teléfono
    @property
    def telefono(self):
        """Devuelve el teléfono."""
        return self.__telefono
 
    @telefono.setter
    def telefono(self, valor):
        """Valida y guarda el teléfono (exactamente 10 dígitos)."""
        if valor is None:                                   # falta el parámetro
            raise ParametroFaltanteError("El teléfono es obligatorio.")
        valor = str(valor).strip()                          # lo convierte a texto sin espacios
        if not valor.isdigit() or len(valor) != 10:
            raise ClienteInvalidoError(f"Teléfono inválido (10 dígitos): {valor!r}")
        self.__telefono = valor                             # guarda el valor válido
 
    def describir(self) -> str:
        """Implementa el método abstracto: resume los datos del cliente."""
        return f"Cliente #{self.id}: {self.nombre} | Doc: {self.documento} | {self.correo}"
 
 
# SECCIÓN 4: SERVICIOS (CLASE ABSTRACTA + 3 ESPECIALIZADOS)
class Servicio(EntidadBase):
    """Clase abstracta Servicio: define el contrato que cumplen todos los servicios."""
 
    def __init__(self, nombre=None, tarifa_hora=None, disponible=True):
        """Valida y guarda los datos comunes a todos los servicios."""
        super().__init__()                                  # genera el id
        if not nombre:                                      # nombre vacío o None
            raise ParametroFaltanteError("El nombre del servicio es obligatorio.")
        # La tarifa debe ser número positivo (bool se excluye porque en Python True es 1).
        if isinstance(tarifa_hora, bool) or not isinstance(tarifa_hora, (int, float)) or tarifa_hora <= 0:
            raise ServicioInvalidoError(f"Tarifa por hora inválida: {tarifa_hora!r}")
        self._nombre = nombre                               # nombre del servicio
        self._tarifa_hora = float(tarifa_hora)              # tarifa por hora como decimal
        self._disponible = bool(disponible)                 # si se puede reservar o no
 
    @property
    def nombre(self):
        """Nombre del servicio (solo lectura)."""
        return self._nombre
 
    @property
    def disponible(self):
        """Indica si el servicio está disponible."""
        return self._disponible
 
    @disponible.setter
    def disponible(self, valor):
        """Permite activar o desactivar el servicio."""
        self._disponible = bool(valor)
 
    def validar_parametros(self, horas):
        """Validación común de disponibilidad y duración; las hijas la extienden con super()."""
        if not self._disponible:                            # servicio apagado
            raise ServicioNoDisponibleError(f"El servicio '{self._nombre}' no está disponible.")
        # La duración debe ser número (no bool), mayor que 0 y de máximo 12 horas.
        if isinstance(horas, bool) or not isinstance(horas, (int, float)) or horas <= 0 or horas > 12:
            raise ServicioInvalidoError(f"Duración inválida (0-12 h): {horas!r}")
 
    @abstractmethod
    def calcular_costo(self, horas):
        """Método abstracto: costo base sin impuestos ni descuentos (cada hija lo sobrescribe)."""
 
    # Sobrecarga simulada: Python no la trae, se logra con argumentos variables
    def costo(self, horas, *args):
        """
        Variantes de cálculo:
          costo(horas)                      -> costo base
          costo(horas, impuesto)            -> costo base + impuesto
          costo(horas, impuesto, descuento) -> costo base con descuento e impuesto
        impuesto y descuento se expresan entre 0 y 1 (0.19 = 19 %).
        """
        if len(args) > 2:                                   # más parámetros de los permitidos
            raise ServicioInvalidoError("costo() acepta como máximo impuesto y descuento.")
        base = self.calcular_costo(horas)                   # polimorfismo: llama a la versión de la hija
        impuesto, descuento = (list(args) + [0.0, 0.0])[:2] # completa con 0.0 lo que no se pasó
        # Ambos valores deben ser números entre 0 y 1.
        if not all(isinstance(v, (int, float)) and not isinstance(v, bool) and 0 <= v <= 1
                   for v in (impuesto, descuento)):
            raise CalculoInconsistenteError("Impuesto y descuento deben estar entre 0 y 1.")
        total = base * (1 - descuento) * (1 + impuesto)     # aplica descuento y luego impuesto
        if total < 0 or total != total:                     # total negativo o NaN (no es número)
            raise CalculoInconsistenteError("El cálculo del costo es inconsistente.")
        return round(total, 2)                              # redondea a 2 decimales
 
 
class ReservaSala(Servicio):
    """Servicio 1: reserva de salas de reuniones."""
 
    def __init__(self, nombre=None, tarifa_hora=None, capacidad=0, proyector=False, disponible=True):
        """Datos propios: capacidad de personas y si incluye proyector."""
        super().__init__(nombre, tarifa_hora, disponible)   # valida los datos comunes
        if isinstance(capacidad, bool) or not isinstance(capacidad, int) or capacidad <= 0:
            raise ServicioInvalidoError(f"Capacidad inválida: {capacidad!r}")
        self._capacidad = capacidad                         # personas que caben
        self._proyector = bool(proyector)                   # con o sin proyector
 
    def calcular_costo(self, horas):
        """Sobrescribe: tarifa por hora + recargo de $15.000/h si tiene proyector."""
        self.validar_parametros(horas)                      # valida disponibilidad y duración
        extra = 15000 * horas if self._proyector else 0     # recargo opcional
        return self._tarifa_hora * horas + extra
 
    def describir(self):
        """Sobrescribe: descripción de la sala."""
        return (f"Sala '{self._nombre}' (cap. {self._capacidad}, "
                f"proyector: {'sí' if self._proyector else 'no'}) ${self._tarifa_hora:,.0f}/h")
 
 
class AlquilerEquipo(Servicio):
    """Servicio 2: alquiler de equipos tecnológicos."""
 
    def __init__(self, nombre=None, tarifa_hora=None, cantidad=1, seguro=False, disponible=True):
        """Datos propios: cantidad de equipos y si lleva seguro."""
        super().__init__(nombre, tarifa_hora, disponible)   # valida los datos comunes
        if isinstance(cantidad, bool) or not isinstance(cantidad, int) or cantidad <= 0:
            raise ServicioInvalidoError(f"Cantidad inválida: {cantidad!r}")
        self._cantidad = cantidad                           # número de equipos
        self._seguro = bool(seguro)                         # con o sin seguro
 
    def validar_parametros(self, horas):
        """Sobrescribe: añade la regla propia de máximo 8 horas."""
        super().validar_parametros(horas)                   # primero las validaciones base
        if horas > 8:                                       # regla específica de equipos
            raise ServicioInvalidoError("Los equipos se alquilan máximo 8 horas.")
 
    def calcular_costo(self, horas):
        """Sobrescribe: tarifa x horas x cantidad, más 5 % si lleva seguro."""
        self.validar_parametros(horas)                      # usa la validación propia de equipos
        base = self._tarifa_hora * horas * self._cantidad   # costo base
        return base * 1.05 if self._seguro else base        # recargo por seguro
 
    def describir(self):
        """Sobrescribe: descripción del equipo."""
        return (f"Equipo '{self._nombre}' x{self._cantidad} "
                f"(seguro: {'sí' if self._seguro else 'no'}) ${self._tarifa_hora:,.0f}/h")
 
 
class AsesoriaEspecializada(Servicio):
    """Servicio 3: asesoría con un especialista."""
 
    # Multiplicador de la tarifa según el nivel del especialista.
    _MULTIPLICADOR = {"junior": 1.0, "senior": 1.5, "experto": 2.0}
 
    def __init__(self, nombre=None, tarifa_hora=None, nivel="junior", disponible=True):
        """Dato propio: nivel del especialista."""
        super().__init__(nombre, tarifa_hora, disponible)   # valida los datos comunes
        if nivel not in self._MULTIPLICADOR:                # solo junior, senior o experto
            raise ServicioInvalidoError(f"Nivel inválido: {nivel!r}")
        self._nivel = nivel                                 # guarda el nivel
 
    def calcular_costo(self, horas):
        """Sobrescribe: tarifa x horas x multiplicador del nivel."""
        self.validar_parametros(horas)                      # valida disponibilidad y duración
        return self._tarifa_hora * horas * self._MULTIPLICADOR[self._nivel]
 
    def describir(self):
        """Sobrescribe: descripción de la asesoría."""
        return f"Asesoría '{self._nombre}' nivel {self._nivel} ${self._tarifa_hora:,.0f}/h"
 
 
# SECCIÓN 5: CLASE RESERVA
class Reserva(EntidadBase):
    """Integra cliente, servicio, duración y estado de una reserva."""
 
    ESTADOS = ("PENDIENTE", "CONFIRMADA", "CANCELADA", "PROCESADA")  # estados posibles
 
    def __init__(self, cliente, servicio, horas):
        """Crea la reserva validando que los objetos y la duración sean correctos."""
        super().__init__()                                  # genera el id
        # Encadenamiento de excepciones: se captura el error original y se relanza envuelto con "from".
        try:
            if not isinstance(cliente, Cliente) or not isinstance(servicio, Servicio):
                raise ReservaInvalidaError("Se requiere un Cliente y un Servicio válidos.")
            servicio.validar_parametros(horas)              # valida disponibilidad y duración
        except ErrorSoftwareFJ as e:
            raise ReservaInvalidaError(f"No se pudo crear la reserva: {e}") from e
        self._cliente = cliente                             # cliente que reserva
        self._servicio = servicio                           # servicio reservado
        self._horas = horas                                 # duración en horas
        self._estado = "PENDIENTE"                          # estado inicial
        self._costo_final = None                            # se calcula al procesar
 
    @property
    def estado(self):
        """Estado actual (solo lectura)."""
        return self._estado
 
    def confirmar(self):
        """Cambia PENDIENTE -> CONFIRMADA."""
        if self._estado != "PENDIENTE":                     # solo se confirma lo pendiente
            raise OperacionNoPermitidaError(f"No se puede confirmar una reserva {self._estado}.")
        self._estado = "CONFIRMADA"                         # cambia el estado
        logger.info("Reserva #%s confirmada.", self.id)     # deja registro en el log
 
    def cancelar(self):
        """Cancela la reserva si no está procesada ni cancelada."""
        if self._estado in ("PROCESADA", "CANCELADA"):      # estados que ya no admiten cancelación
            raise OperacionNoPermitidaError(f"No se puede cancelar una reserva {self._estado}.")
        self._estado = "CANCELADA"                          # cambia el estado
        logger.info("Reserva #%s cancelada.", self.id)      # deja registro en el log
 
    def procesar(self, impuesto=0.19, descuento=0.0):
        """Cambia CONFIRMADA -> PROCESADA calculando el costo final (try/except/else/finally)."""
        try:
            if self._estado != "CONFIRMADA":                # solo se procesa lo confirmado
                raise OperacionNoPermitidaError("Solo se procesan reservas confirmadas.")
            # Usa el método "sobrecargado" con impuesto y descuento.
            total = self._servicio.costo(self._horas, impuesto, descuento)
        except ErrorSoftwareFJ as e:
            logger.error("Fallo al procesar reserva #%s: %s", self.id, e)   
