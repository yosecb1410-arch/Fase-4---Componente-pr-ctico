# SECCIÓN 1: EXCEPCIONES PERSONALIZADAS
class ErrorSoftwareFJ(Exception):
    """Excepción base del sistema: permite capturar cualquier error propio con un solo except."""
 
 
class ClienteInvalidoError(ErrorSoftwareFJ):
    """Datos de cliente inválidos (nombre, documento, correo o teléfono)."""
 
 
class ServicioInvalidoError(ErrorSoftwareFJ):
    """Parámetros inválidos al crear o usar un servicio."""
 
 
class ServicioNoDisponibleError(ErrorSoftwareFJ):
    """El servicio existe, pero está marcado como no disponible."""
 
 
class ParametroFaltanteError(ErrorSoftwareFJ):
    """Falta un parámetro obligatorio (llegó None o vacío)."""
 
 
class CalculoInconsistenteError(ErrorSoftwareFJ):
    """Un cálculo de costos produjo valores inconsistentes."""
 
 
class ReservaInvalidaError(ErrorSoftwareFJ):
    """La reserva no pudo crearse o procesarse."""
 
 
class OperacionNoPermitidaError(ErrorSoftwareFJ):
    """Se intentó una operación o cambio de estado que no está permitido."""
 
 
# SECCIÓN 2: CONFIGURACIÓN DEL ARCHIVO DE LOGS
# Carpeta donde está este archivo; así el log se crea junto al programa sin importar desde dónde se ejecute.
CARPETA_BASE = os.path.dirname(os.path.abspath(__file__))
# Ruta completa del archivo de log: <carpeta>/logs/software_fj.log
RUTA_LOG = os.path.join(CARPETA_BASE, "logs", "software_fj.log")
# Crea la carpeta "logs" si todavía no existe (exist_ok evita error si ya existe).
os.makedirs(os.path.dirname(RUTA_LOG), exist_ok=True)
 
# Obtiene (o crea) el registrador con nombre propio del sistema.
logger = logging.getLogger("SoftwareFJ")
# Nivel mínimo a registrar: INFO incluye INFO, WARNING, ERROR y CRITICAL.
logger.setLevel(logging.INFO)
# Evita agregar el manejador dos veces si el módulo se carga más de una vez.
if not logger.handlers:
    # Manejador que escribe en el archivo (UTF-8 para tildes y ñ).
    _manejador = logging.FileHandler(RUTA_LOG, encoding="utf-8")
