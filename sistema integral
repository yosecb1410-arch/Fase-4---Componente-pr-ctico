# SECCIÓN 3: CLASE ABSTRACTA BASE Y CLIENTE
class EntidadBase(ABC):
    # Clase abstracta que representa cualquier entidad general del sistema.

    _contador = 0  # contador compartido para dar identificadores únicos

    def __init__(self):
        EntidadBase._contador += 1        # incrementa el contador global
        self._id = EntidadBase._contador  # id protegido (encapsulado)

    @property
    def id(self):
        # Identificador de solo lectura.
        return self._id

    @abstractmethod
    def describir(self) -> str:
        # Cada entidad debe describirse a sí misma (polimorfismo).
        pass

    def __str__(self):
        return self.describir()


class Cliente(EntidadBase):
    # Cliente con datos personales encapsulados y validados.

    _PATRON_CORREO = re.compile(r"^[\w.+-]+@[\w-]+\.[\w.-]+$")  # texto@dominio.ext

    def __init__(self, nombre=None, documento=None, correo=None, telefono=None):
        super().__init__()          # genera el id
        self.nombre = nombre        # cada asignación ejecuta su setter (validación)
        self.documento = documento
        self.correo = correo
        self.telefono = telefono

    @property
    def nombre(self):
        return self.__nombre

    @nombre.setter
    def nombre(self, valor):
        if valor is None:
            raise ParametroFaltanteError("El nombre es obligatorio.")
        if not isinstance(valor, str) or len(valor.strip()) < 3 or any(c.isdigit() for c in valor):
            raise ClienteInvalidoError(f"Nombre inválido: {valor!r}")
        self.__nombre = valor.strip().title()

    @property
    def documento(self):
        return self.__documento

    @documento.setter
    def documento(self, valor):
        if valor is None:
            raise ParametroFaltanteError("El documento es obligatorio.")
        valor = str(valor).strip()
        if not valor.isdigit() or not 6 <= len(valor) <= 12:
            raise ClienteInvalidoError(f"Documento inválido (6-12 dígitos): {valor!r}")
        self.__documento = valor

    @property
    def correo(self):
        return self.__correo

    @correo.setter
    def correo(self, valor):
        if valor is None:
            raise ParametroFaltanteError("El correo es obligatorio.")
        if not isinstance(valor, str) or not self._PATRON_CORREO.match(valor):
            raise ClienteInvalidoError(f"Correo inválido: {valor!r}")
        self.__correo = valor.lower()

    @property
    def telefono(self):
        return self.__telefono

    @telefono.setter
    def telefono(self, valor):
        if valor is None:
            raise ParametroFaltanteError("El teléfono es obligatorio.")
        valor = str(valor).strip()
        if not valor.isdigit() or len(valor) != 10:
            raise ClienteInvalidoError(f"Teléfono inválido (10 dígitos): {valor!r}")
        self.__telefono = valor

    def describir(self) -> str:
        return f"Cliente #{self.id}: {self.nombre} | Doc: {self.documento} | {self.correo}"


# SECCIÓN 4: SERVICIOS (ABSTRACTA + 3 ESPECIALIZADOS)
class Servicio(EntidadBase):
    # Clase abstracta Servicio: contrato común de todos los servicios.

    def __init__(self, nombre=None, tarifa_hora=None, disponible=True):
        super().__init__()
        if not nombre:
            raise ParametroFaltanteError("El nombre del servicio es obligatorio.")
        if isinstance(tarifa_hora, bool) or not isinstance(tarifa_hora, (int, float)) or tarifa_hora <= 0:
            raise ServicioInvalidoError(f"Tarifa por hora inválida: {tarifa_hora!r}")
        self._nombre = nombre
        self._tarifa_hora = float(tarifa_hora)
        self._disponible = bool(disponible)

    @property
    def nombre(self):
        return self._nombre

    @property
    def tarifa_hora(self):
        return self._tarifa_hora

    @property
    def disponible(self):
        return self._disponible

    @disponible.setter
    def disponible(self, valor):
        self._disponible = bool(valor)

    @property
    def tipo(self):
        # Nombre de la clase concreta (útil para mostrar en tablas).
        return type(self).__name__

    def validar_parametros(self, horas):
        # Validación común; las hijas la extienden con super().
        if not self._disponible:
            raise ServicioNoDisponibleError(f"El servicio '{self._nombre}' no está disponible.")
        if isinstance(horas, bool) or not isinstance(horas, (int, float)) or horas <= 0 or horas > 12:
            raise ServicioInvalidoError(f"Duración inválida (0-12 h): {horas!r}")

    @abstractmethod
    def calcular_costo(self, horas):
        # Costo base sin impuestos ni descuentos (cada hija lo sobrescribe).
        pass

    def costo(self, horas, *args):
        # Sobrecarga simulada con argumentos variables:
        #   costo(horas) | costo(horas, impuesto) | costo(horas, impuesto, descuento)
        # impuesto y descuento van entre 0 y 1 (0.19 = 19 %).
        if len(args) > 2:
            raise ServicioInvalidoError("costo() acepta como máximo impuesto y descuento.")
        base = self.calcular_costo(horas)                    # polimorfismo
        impuesto, descuento = (list(args) + [0.0, 0.0])[:2]  # completa con 0.0
        if not all(isinstance(v, (int, float)) and not isinstance(v, bool) and 0 <= v <= 1
                   for v in (impuesto, descuento)):
            raise CalculoInconsistenteError("Impuesto y descuento deben estar entre 0 y 1.")
        total = base * (1 - descuento) * (1 + impuesto)
        if total < 0 or total != total:                      # negativo o NaN
            raise CalculoInconsistenteError("El cálculo del costo es inconsistente.")
        return round(total, 2)


class ReservaSala(Servicio):
    # Servicio 1: reserva de salas.

    def __init__(self, nombre=None, tarifa_hora=None, capacidad=0, proyector=False, disponible=True):
        super().__init__(nombre, tarifa_hora, disponible)
        if isinstance(capacidad, bool) or not isinstance(capacidad, int) or capacidad <= 0:
            raise ServicioInvalidoError(f"Capacidad inválida: {capacidad!r}")
        self._capacidad = capacidad
        self._proyector = bool(proyector)

    def calcular_costo(self, horas):
        self.validar_parametros(horas)
        extra = 15000 * horas if self._proyector else 0      # recargo por proyector
        return self._tarifa_hora * horas + extra

    def describir(self):
        return (f"Sala '{self._nombre}' (cap. {self._capacidad}, "
                f"proyector: {'sí' if self._proyector else 'no'}) ${self._tarifa_hora:,.0f}/h")


class AlquilerEquipo(Servicio):
    # Servicio 2: alquiler de equipos.

    def __init__(self, nombre=None, tarifa_hora=None, cantidad=1, seguro=False, disponible=True):
        super().__init__(nombre, tarifa_hora, disponible)
        if isinstance(cantidad, bool) or not isinstance(cantidad, int) or cantidad <= 0:
            raise ServicioInvalidoError(f"Cantidad inválida: {cantidad!r}")
        self._cantidad = cantidad
        self._seguro = bool(seguro)

    def validar_parametros(self, horas):
        super().validar_parametros(horas)
        if horas > 8:                                        # regla propia de equipos
            raise ServicioInvalidoError("Los equipos se alquilan máximo 8 horas.")

    def calcular_costo(self, horas):
        self.validar_parametros(horas)
        base = self._tarifa_hora * horas * self._cantidad
        return base * 1.05 if self._seguro else base         # +5 % con seguro

    def describir(self):
        return (f"Equipo '{self._nombre}' x{self._cantidad} "
                f"(seguro: {'sí' if self._seguro else 'no'}) ${self._tarifa_hora:,.0f}/h")


class AsesoriaEspecializada(Servicio):
    # Servicio 3: asesoría con especialista.

    _MULTIPLICADOR = {"junior": 1.0, "senior": 1.5, "experto": 2.0}

    def __init__(self, nombre=None, tarifa_hora=None, nivel="junior", disponible=True):
        super().__init__(nombre, tarifa_hora, disponible)
        if nivel not in self._MULTIPLICADOR:
            raise ServicioInvalidoError(f"Nivel inválido: {nivel!r}")
        self._nivel = nivel

    def calcular_costo(self, horas):
        self.validar_parametros(horas)
        return self._tarifa_hora * horas * self._MULTIPLICADOR[self._nivel]

    def describir(self):
        return f"Asesoría '{self._nombre}' nivel {self._nivel} ${self._tarifa_hora:,.0f}/h"
# SECCIÓN 5: CLASE RESERVA
class Reserva(EntidadBase):
    # Integra cliente, servicio, duración y estado.

    ESTADOS = ("PENDIENTE", "CONFIRMADA", "CANCELADA", "PROCESADA")

    def __init__(self, cliente, servicio, horas):
        super().__init__()
        try:                                                 # encadenamiento de excepciones
            if not isinstance(cliente, Cliente) or not isinstance(servicio, Servicio):
                raise ReservaInvalidaError("Se requiere un Cliente y un Servicio válidos.")
            servicio.validar_parametros(horas)
        except ErrorSoftwareFJ as e:
            raise ReservaInvalidaError(f"No se pudo crear la reserva: {e}") from e
        self._cliente, self._servicio, self._horas = cliente, servicio, horas
        self._estado = "PENDIENTE"
        self._costo_final = None

    @property
    def cliente(self):
        return self._cliente

    @property
    def servicio(self):
        return self._servicio

    @property
    def horas(self):
        return self._horas

    @property
    def estado(self):
        return self._estado

    @property
    def costo_final(self):
        return self._costo_final

    def confirmar(self):
        # PENDIENTE -> CONFIRMADA.
        if self._estado != "PENDIENTE":
            raise OperacionNoPermitidaError(f"No se puede confirmar una reserva {self._estado}.")
        self._estado = "CONFIRMADA"
        logger.info("Reserva #%s confirmada.", self.id)

    def cancelar(self):
        # Cancela si no está procesada ni cancelada.
        if self._estado in ("PROCESADA", "CANCELADA"):
            raise OperacionNoPermitidaError(f"No se puede cancelar una reserva {self._estado}.")
        self._estado = "CANCELADA"
        logger.info("Reserva #%s cancelada.", self.id)

    def procesar(self, impuesto=0.19, descuento=0.0):
        # CONFIRMADA -> PROCESADA con try/except/else/finally.
        try:
            if self._estado != "CONFIRMADA":
                raise OperacionNoPermitidaError("Solo se procesan reservas confirmadas.")
            total = self._servicio.costo(self._horas, impuesto, descuento)
        except ErrorSoftwareFJ as e:
            logger.error("Fallo al procesar reserva #%s: %s", self.id, e)
            raise ReservaInvalidaError(f"No se pudo procesar la reserva #{self.id}") from e
        else:                                                # solo si no hubo error
            self._estado, self._costo_final = "PROCESADA", total
            logger.info("Reserva #%s procesada. Total: $%s", self.id, f"{total:,.2f}")
            return total
        finally:                                             # siempre se ejecuta
            logger.info("Intento de procesamiento de reserva #%s finalizado (estado=%s).",
                        self.id, self._estado)

    def describir(self):
        costo = f" | Total ${self._costo_final:,.2f}" if self._costo_final is not None else ""
        return (f"Reserva #{self.id} [{self._estado}] {self._cliente.nombre} -> "
                f"{self._servicio.nombre} x{self._horas}h{costo}")


# SECCIÓN 6: DATOS EN MEMORIA Y OPERACIONES (usadas por la interfaz y la simulación)
clientes, servicios, reservas = [], [], []  # listas internas: reemplazan a la base de datos


def registrar_cliente(**datos):
    # Crea un Cliente y, solo si es válido, lo agrega a la lista.
    cliente = Cliente(**datos)
    clientes.append(cliente)
    return cliente


def registrar_servicio(clase, **datos):
    # Crea un servicio de la clase indicada y, solo si es válido, lo agrega a la lista.
    servicio = clase(**datos)
    servicios.append(servicio)
    return servicio


def reservar(indice_cliente, indice_servicio, horas, confirmar=True, procesar=True, **kw):
    # Crea una reserva y opcionalmente la confirma y procesa (se usa en la simulación).
    reserva = Reserva(clientes[indice_cliente], servicios[indice_servicio], horas)
    reservas.append(reserva)
    if confirmar:
        reserva.confirmar()
    if procesar:
        reserva.procesar(**kw)
    return reserva


def servicio_no_disponible():
    # Apaga la primera sala y trata de reservarla (debe fallar de forma controlada).
    servicios[0].disponible = False
    return reservar(0, 0, 2)


def simular(salida):
    # Ejecuta 15 operaciones (válidas e inválidas). 'salida' es una función que recibe
    # cada línea de texto (print en consola o escritura en la ventana).
    # Antes de empezar se vacían las listas para que los índices coincidan.
    clientes.clear(); servicios.clear(); reservas.clear()
    logger.info("Inicio de la simulación")

    def ejecutar(num, titulo, accion):
        # Ejecuta una operación sin dejar que ningún error detenga el programa.
        salida(f"\n[{num:02d}] {titulo}")
        try:
            resultado = accion()
        except ErrorSoftwareFJ as e:                         # error propio
            logger.error("Operación %02d (%s) falló: %s | causa: %r", num, titulo, e, e.__cause__)
            salida(f"   [ERROR] Error controlado: {e}" + (f"  (causa: {e.__cause__})" if e.__cause__ else ""))
        except Exception as e:                               # error inesperado
            logger.critical("Operación %02d error inesperado: %r", num, e)
            salida(f"   [ERROR] Error inesperado controlado: {e!r}")
        else:
            logger.info("Operación %02d (%s) exitosa.", num, titulo)
            salida(f"   [OK] {resultado}")
        finally:
            logger.info("Fin de operación %02d.", num)

    ejecutar(1, "Cliente válido", lambda: registrar_cliente(
        nombre="ana maría pérez", documento="1012345678", correo="ana@correo.com", telefono="3101234567"))
    ejecutar(2, "Cliente con correo inválido", lambda: registrar_cliente(
        nombre="Luis Gómez", documento="52345678", correo="luis@@x", telefono="3209876543"))
    ejecutar(3, "Cliente sin documento (parámetro faltante)", lambda: registrar_cliente(
        nombre="Carla Ruiz", correo="c@x.com", telefono="3001112233"))
    ejecutar(4, "Segundo cliente válido", lambda: registrar_cliente(
        nombre="Pedro Díaz", documento="80123456", correo="pedro@correo.com", telefono="3157654321"))
    ejecutar(5, "Sala válida", lambda: registrar_servicio(
        ReservaSala, nombre="Sala Andes", tarifa_hora=50000, capacidad=10, proyector=True))
    ejecutar(6, "Equipo con cantidad inválida", lambda: registrar_servicio(
        AlquilerEquipo, nombre="Portátil", tarifa_hora=8000, cantidad=0))
    ejecutar(7, "Equipo válido", lambda: registrar_servicio(
        AlquilerEquipo, nombre="Portátil", tarifa_hora=8000, cantidad=3, seguro=True))
    ejecutar(8, "Asesoría válida (senior)", lambda: registrar_servicio(
        AsesoriaEspecializada, nombre="Ciberseguridad", tarifa_hora=90000, nivel="senior"))
    ejecutar(9, "Reserva exitosa (sala 3h, IVA 19%)", lambda: reservar(0, 0, 3))
    ejecutar(10, "Reserva con descuento del 10% (asesoría 2h)",
             lambda: reservar(1, 2, 2, impuesto=0.19, descuento=0.10))
    ejecutar(11, "Reserva con duración inválida (15h)", lambda: reservar(0, 0, 15))
    ejecutar(12, "Equipo por 10h (regla de máximo 8h)", lambda: reservar(0, 1, 10))
    ejecutar(13, "Reserva sobre servicio no disponible", servicio_no_disponible)
    ejecutar(14, "Cancelar una reserva ya procesada", lambda: reservas[0].cancelar())
    ejecutar(15, "Descuento inconsistente (150%)", lambda: reservar(1, 2, 1, descuento=1.5))

    salida("\n=== Resumen de reservas ===")
    for r in reservas:
        salida("  " + str(r))
    salida(f"\nArchivo de logs: {RUTA_LOG}")
    logger.info("Fin de la simulación")


def a_numero(texto, campo, entero=False):
    # Convierte el texto de un campo a número; vacío -> None; inválido -> ServicioInvalidoError.
    texto = texto.strip().replace(",", ".")
    if texto == "":
        return None
    try:
        return int(texto) if entero else float(texto)
    except ValueError as e:
        raise ServicioInvalidoError(f"'{campo}' debe ser un número válido: {texto!r}") from e


