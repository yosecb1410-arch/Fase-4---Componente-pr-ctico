class ErrorSoftwareFJ(Exception):
    # Excepción base del sistema: un solo except captura cualquier error propio.
    pass


class ClienteInvalidoError(ErrorSoftwareFJ):
    # Datos de cliente inválidos.
    pass


class ServicioInvalidoError(ErrorSoftwareFJ):
    # Parámetros inválidos al crear o usar un servicio.
    pass


class ServicioNoDisponibleError(ErrorSoftwareFJ):
    # El servicio está marcado como no disponible.
    pass


class ParametroFaltanteError(ErrorSoftwareFJ):
    # Falta un parámetro obligatorio.
    pass


class CalculoInconsistenteError(ErrorSoftwareFJ):
    # Un cálculo de costos produjo valores inconsistentes.
    pass


class ReservaInvalidaError(ErrorSoftwareFJ):
    # La reserva no pudo crearse o procesarse.
    pass


class OperacionNoPermitidaError(ErrorSoftwareFJ):
    # Operación o cambio de estado no permitido.
    pass


