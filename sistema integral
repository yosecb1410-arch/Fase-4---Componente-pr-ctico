# SECCIÓN 3: CLASE ABSTRACTA BASE Y CLIENTE
class EntidadBase(ABC):
    # Clase abstracta que representa cualquier entidad general del sistema.

    _contador = 0  # contador compartido para dar identificadores únicos

    def __init__(self):
        EntidadBase._contador += 1        # incrementa el contador global
        self._id = EntidadBase._contador  # id protegido (encapsulado)

    @property
    def id(self):
        # Identificador de solo lectura.
        return self._id

    @abstractmethod
    def describir(self) -> str:
        # Cada entidad debe describirse a sí misma (polimorfismo).
        pass

    def __str__(self):
        return self.describir()


class Cliente(EntidadBase):
    # Cliente con datos personales encapsulados y validados.

    _PATRON_CORREO = re.compile(r"^[\w.+-]+@[\w-]+\.[\w.-]+$")  # texto@dominio.ext

    def __init__(self, nombre=None, documento=None, correo=None, telefono=None):
        super().__init__()          # genera el id
        self.nombre = nombre        # cada asignación ejecuta su setter (validación)
        self.documento = documento
        self.correo = correo
        self.telefono = telefono

    @property
    def nombre(self):
        return self.__nombre

    @nombre.setter
    def nombre(self, valor):
        if valor is None:
            raise ParametroFaltanteError("El nombre es obligatorio.")
        if not isinstance(valor, str) or len(valor.strip()) < 3 or any(c.isdigit() for c in valor):
            raise ClienteInvalidoError(f"Nombre inválido: {valor!r}")
        self.__nombre = valor.strip().title()

    @property
    def documento(self):
        return self.__documento

    @documento.setter
    def documento(self, valor):
        if valor is None:
            raise ParametroFaltanteError("El documento es obligatorio.")
        valor = str(valor).strip()
        if not valor.isdigit() or not 6 <= len(valor) <= 12:
            raise ClienteInvalidoError(f"Documento inválido (6-12 dígitos): {valor!r}")
        self.__documento = valor

    @property
    def correo(self):
        return self.__correo

    @correo.setter
    def correo(self, valor):
        if valor is None:
            raise ParametroFaltanteError("El correo es obligatorio.")
        if not isinstance(valor, str) or not self._PATRON_CORREO.match(valor):
            raise ClienteInvalidoError(f"Correo inválido: {valor!r}")
        self.__correo = valor.lower()

    @property
    def telefono(self):
        return self.__telefono

    @telefono.setter
    def telefono(self, valor):
        if valor is None:
            raise ParametroFaltanteError("El teléfono es obligatorio.")
        valor = str(valor).strip()
        if not valor.isdigit() or len(valor) != 10:
            raise ClienteInvalidoError(f"Teléfono inválido (10 dígitos): {valor!r}")
        self.__telefono = valor

    def describir(self) -> str:
        return f"Cliente #{self.id}: {self.nombre} | Doc: {self.documento} | {self.correo}"


# SECCIÓN 4: SERVICIOS (ABSTRACTA + 3 ESPECIALIZADOS)
class Servicio(EntidadBase):
    # Clase abstracta Servicio: contrato común de todos los servicios.

    def __init__(self, nombre=None, tarifa_hora=None, disponible=True):
        super().__init__()
        if not nombre:
            raise ParametroFaltanteError("El nombre del servicio es obligatorio.")
        if isinstance(tarifa_hora, bool) or not isinstance(tarifa_hora, (int, float)) or tarifa_hora <= 0:
            raise ServicioInvalidoError(f"Tarifa por hora inválida: {tarifa_hora!r}")
        self._nombre = nombre
        self._tarifa_hora = float(tarifa_hora)
        self._disponible = bool(disponible)

    @property
    def nombre(self):
        return self._nombre

    @property
    def tarifa_hora(self):
        return self._tarifa_hora

    @property
    def disponible(self):
        return self._disponible

    @disponible.setter
    def disponible(self, valor):
        self._disponible = bool(valor)

    @property
    def tipo(self):
        # Nombre de la clase concreta (útil para mostrar en tablas).
        return type(self).__name__

    def validar_parametros(self, horas):
        # Validación común; las hijas la extienden con super().
        if not self._disponible:
            raise ServicioNoDisponibleError(f"El servicio '{self._nombre}' no está disponible.")
        if isinstance(horas, bool) or not isinstance(horas, (int, float)) or horas <= 0 or horas > 12:
            raise ServicioInvalidoError(f"Duración inválida (0-12 h): {horas!r}")

    @abstractmethod
    def calcular_costo(self, horas):
        # Costo base sin impuestos ni descuentos (cada hija lo sobrescribe).
        pass

    def costo(self, horas, *args):
        # Sobrecarga simulada con argumentos variables:
        #   costo(horas) | costo(horas, impuesto) | costo(horas, impuesto, descuento)
        # impuesto y descuento van entre 0 y 1 (0.19 = 19 %).
        if len(args) > 2:
            raise ServicioInvalidoError("costo() acepta como máximo impuesto y descuento.")
        base = self.calcular_costo(horas)                    # polimorfismo
        impuesto, descuento = (list(args) + [0.0, 0.0])[:2]  # completa con 0.0
        if not all(isinstance(v, (int, float)) and not isinstance(v, bool) and 0 <= v <= 1
                   for v in (impuesto, descuento)):
            raise CalculoInconsistenteError("Impuesto y descuento deben estar entre 0 y 1.")
        total = base * (1 - descuento) * (1 + impuesto)
        if total < 0 or total != total:                      # negativo o NaN
            raise CalculoInconsistenteError("El cálculo del costo es inconsistente.")
        return round(total, 2)


class ReservaSala(Servicio):
    # Servicio 1: reserva de salas.

    def __init__(self, nombre=None, tarifa_hora=None, capacidad=0, proyector=False, disponible=True):
        super().__init__(nombre, tarifa_hora, disponible)
        if isinstance(capacidad, bool) or not isinstance(capacidad, int) or capacidad <= 0:
            raise ServicioInvalidoError(f"Capacidad inválida: {capacidad!r}")
        self._capacidad = capacidad
        self._proyector = bool(proyector)

    def calcular_costo(self, horas):
        self.validar_parametros(horas)
        extra = 15000 * horas if self._proyector else 0      # recargo por proyector
        return self._tarifa_hora * horas + extra

    def describir(self):
        return (f"Sala '{self._nombre}' (cap. {self._capacidad}, "
                f"proyector: {'sí' if self._proyector else 'no'}) ${self._tarifa_hora:,.0f}/h")


class AlquilerEquipo(Servicio):
    # Servicio 2: alquiler de equipos.

    def __init__(self, nombre=None, tarifa_hora=None, cantidad=1, seguro=False, disponible=True):
        super().__init__(nombre, tarifa_hora, disponible)
        if isinstance(cantidad, bool) or not isinstance(cantidad, int) or cantidad <= 0:
            raise ServicioInvalidoError(f"Cantidad inválida: {cantidad!r}")
        self._cantidad = cantidad
        self._seguro = bool(seguro)

    def validar_parametros(self, horas):
        super().validar_parametros(horas)
        if horas > 8:                                        # regla propia de equipos
            raise ServicioInvalidoError("Los equipos se alquilan máximo 8 horas.")

    def calcular_costo(self, horas):
        self.validar_parametros(horas)
        base = self._tarifa_hora * horas * self._cantidad
        return base * 1.05 if self._seguro else base         # +5 % con seguro

    def describir(self):
        return (f"Equipo '{self._nombre}' x{self._cantidad} "
                f"(seguro: {'sí' if self._seguro else 'no'}) ${self._tarifa_hora:,.0f}/h")


class AsesoriaEspecializada(Servicio):
    # Servicio 3: asesoría con especialista.

    _MULTIPLICADOR = {"junior": 1.0, "senior": 1.5, "experto": 2.0}

    def __init__(self, nombre=None, tarifa_hora=None, nivel="junior", disponible=True):
        super().__init__(nombre, tarifa_hora, disponible)
        if nivel not in self._MULTIPLICADOR:
            raise ServicioInvalidoError(f"Nivel inválido: {nivel!r}")
        self._nivel = nivel

    def calcular_costo(self, horas):
        self.validar_parametros(horas)
        return self._tarifa_hora * horas * self._MULTIPLICADOR[self._nivel]

    def describir(self):
        return f"Asesoría '{self._nombre}' nivel {self._nivel} ${self._tarifa_hora:,.0f}/h"


